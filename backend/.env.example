# 复制为 backend/.env，填数据库密码和 DeepSeek 密钥就能跑。

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ledger

# ---- 大模型 ----
# DeepSeek 密钥，一个密钥同时启用：一句话记账、自然语言查账、小票/截图识别、多轮对话。
AI_API_KEY=

# 换模型或网关时才需要下面两项，默认走 DeepSeek 官方与 deepseek-flash。
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-flash
